<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Fruit</title>
</head>

<body>
    <a href="/fruits/<%= fruit._id %>">Back to <%= fruit._name %></a>
    <h1>Editing <%= fruit._name %></h1>
    <form action="/fruits/<%= fruit._id %>?_method=PUT" method="post">
        <label for="name">Name:</label>
        <input type="text" name="name" id="name" value="<%= fruit.name %>">

        <label for="isReadyToEat">Ready to Eat?</label>
        <input type="checkbox" name="isReadyToEat" id="isReadyToEat"
        <% if (fruit.isReadyToEat){ %>
            checked
        <% } %> >

        <button type="submit">Update Fruit</button>
    </form>
    <a href="/fruits">Back to Fruits</a>
</body>

</html>